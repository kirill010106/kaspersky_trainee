# Скопируйте в .env для Docker Compose и заполните три значения.
# Для каждого секрета используйте отдельное значение: openssl rand -hex 32
# При повторном запуске с прежним томом БД сохраните POSTGRES_PASSWORD.
POSTGRES_PASSWORD=
READER_KEY=
WRITER_KEY=

# compose.yaml сам задает DATABASE_URL, HTTPS_ADDR и пути TLS-файлов внутри
# контейнеров. Настройки ниже из .env в контейнер API не передаются.
# При ручном запуске Go задайте в окружении процесса обязательные значения:
# DATABASE_URL=postgres://safeboard:<password>@127.0.0.1:55432/safeboard?sslmode=disable
# HTTPS_ADDR=127.0.0.1:8443
# TLS_CERT_FILE=.local/safeboard.pem
# TLS_KEY_FILE=.local/safeboard.key
# READER_KEY и WRITER_KEY тоже должны быть в окружении процесса.
# Сам Go-сервис не загружает .env автоматически.

# Необязательные настройки serve и их значения по умолчанию:
# DB_QUERY_TIMEOUT=3s
# READINESS_TIMEOUT=1s
# SHUTDOWN_TIMEOUT=10s
# DB_MAX_CONNS=10
# READ_HEADER_TIMEOUT=3s
# READ_TIMEOUT=10s
# WRITE_TIMEOUT=15s
# IDLE_TIMEOUT=60s
# MAX_HEADER_BYTES=16384
# API_RATE_PER_MINUTE=120
# READINESS_RATE_PER_MINUTE=120
